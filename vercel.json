{
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/assemble-video.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/assemble-batch.js": {
      "maxDuration": 300,
      "memory": 3008,
      "includeFiles": "node_modules/ffmpeg-static/**"
    },
    "api/assemble-final.js": {
      "maxDuration": 300,
      "memory": 3008,
      "includeFiles": "node_modules/ffmpeg-static/**"
    }
  }
}
