{
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/analyze.js": {
      "maxDuration": 300
    },
    "api/diagnose.js": {
      "maxDuration": 30
    },
    "api/test-batch.js": {
      "maxDuration": 120,
      "memory": 2048,
      "includeFiles": "node_modules/ffmpeg-static/**"
    },
    "api/assemble-video.js": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "node_modules/ffmpeg-static/**"
    },
    "api/assemble-batch.js": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "node_modules/ffmpeg-static/**"
    },
    "api/assemble-final.js": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "node_modules/ffmpeg-static/**"
    }
  }
}
